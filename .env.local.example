# Tylko lokalny Docker. Ten plik nie jest używany przez Laragona.
# Opcjonalnie: Copy-Item .env.local.example .env.local
#              docker compose --env-file .env.local up -d --build

DOCKER_APP_URL=http://localhost:8080
DOCKER_APP_PORT=8080
DOCKER_POSTGRES_PORT=5433
DOCKER_VALKEY_PORT=6380
DOCKER_MINIO_CONSOLE_PORT=19001
DOCKER_MAILPIT_PORT=8025

DOCKER_POSTGRES_DB=zrodlo_slowa
DOCKER_POSTGRES_USER=zrodlo
DOCKER_POSTGRES_PASSWORD=local-only-change-me
DOCKER_POSTGRES_MAX_CONNECTIONS=100
DOCKER_VALKEY_PASSWORD=local-only-change-me
DOCKER_MINIO_ROOT_USER=zrodlo-local
DOCKER_MINIO_ROOT_PASSWORD=local-only-change-me
DOCKER_S3_REGION=us-east-1
DOCKER_S3_BUCKET=zrodlo-slowa-local

DOCKER_APP_KEY=local-only-change-me
DOCKER_PASSWORD_PEPPER=local-only-change-me
DOCKER_FINANCE_HMAC_KEY=local-only-change-me

DORS3_MODE=prepare
DORS3_FIDO2_ENABLED=false
DORS3_FIDO2_REQUIRED=false
DORS3_CRITICAL_STEP_UP=password
DORS3_PHYSICAL_APPROVAL=disabled
WEBAUTHN_ENABLED=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080
