    <color name="dors3_red">#B90012</color>
    <color name="dors3_red_dark">#8F0010</color>
    <color name="dors3_black">#0B0B0B</color>
    <color name="dors3_surface_dark">#1A1A1A</color>
    <color name="dors3_outline_dark">#3A3A3A</color>
    <color name="dors3_text_secondary_dark">#B3B3B3</color>
