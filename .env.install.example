# Skopiuj do .env i uzupełnij lokalne hasła.
# Ten plik jest przykładem instalacyjnym, bez sekretów produkcyjnych.

APP_NAME="ŹRÓDŁO SŁOWA"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=wygeneruj-co-najmniej-32-losowe-znaki

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zrodlo_slowa
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_SCHEMA=public
DB_SSLMODE=prefer
DB_APPLICATION_NAME=zrodlo-slowa-installer
DB_ALLOW_CREATE_DATABASE=false
DB_ALLOW_CREATE_SCHEMA=false

SESSION_NAME=zrodlo_slowa_session
SESSION_LIFETIME=0
SESSION_SECURE=false
SESSION_SAME_SITE=Lax
SESSION_DOMAIN=
SESSION_DRIVER=file
SESSION_SAVE_PATH=storage/sessions
SESSION_TTL_SECONDS=86400
PASSWORD_PEPPER=wygeneruj-dlugi-losowy-pepper
FINANCE_HMAC_KEY=wygeneruj-osobny-dlugi-losowy-sekret

VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DATABASE=0
VALKEY_TLS=false
VALKEY_PREFIX=zrodlo-slowa:local
VALKEY_CONNECT_TIMEOUT=0.5
VALKEY_READ_TIMEOUT=0.5
CACHE_DRIVER=file
RATE_LIMIT_DRIVER=database
LOCK_DRIVER=none
QUEUE_SIGNAL_DRIVER=none

OBJECT_STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=public/uploads
LOCAL_STORAGE_PUBLIC_PREFIX=/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=false
S3_MAX_ATTEMPTS=3
S3_CONNECT_TIMEOUT=2
S3_REQUEST_TIMEOUT=10
S3_MAX_READ_BYTES=10485760

ADMIN_EMAIL=admin@zrodlo-slowa.local
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

MAIL_TRANSPORT=smtp
MAILER_DSN=
MAIL_FROM_ADDRESS=no-reply@zrodlo-slowa.local
MAIL_FROM_NAME="ŹRÓDŁO SŁOWA"
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=tls

GOOGLE_LOGIN_ENABLED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

APPLE_LOGIN_ENABLED=0
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=http://localhost:8080/auth/apple/callback
