# Izolowane testy uruchamiane w Dockerze. Nie wskazuj tutaj bazy Laragona.

APP_ENV=test
APP_DEBUG=false
APP_URL=http://localhost:8080

DB_DRIVER=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=zrodlo_slowa
DB_USER=zrodlo_test
DB_PASS=replace-for-local-tests
DB_SSLMODE=disable
DB_SCHEMA=zrodlo_slowa_test
DB_APPLICATION_NAME=zrodlo-slowa-tests
DB_ALLOW_CREATE_DATABASE=false
DB_ALLOW_CREATE_SCHEMA=true

VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=replace-for-local-tests
VALKEY_DATABASE=1
VALKEY_TLS=false
VALKEY_PREFIX=zrodlo-slowa:test
VALKEY_CONNECT_TIMEOUT=0.5
VALKEY_READ_TIMEOUT=0.5
SESSION_DRIVER=valkey
SESSION_TTL_SECONDS=3600
CACHE_DRIVER=valkey
RATE_LIMIT_DRIVER=valkey
LOCK_DRIVER=valkey
QUEUE_SIGNAL_DRIVER=valkey
QUEUE_DRIVER=database

OBJECT_STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=zrodlo-slowa-test
S3_ACCESS_KEY=zrodlo-test
S3_SECRET_KEY=replace-for-local-tests
S3_PATH_STYLE=true
S3_MAX_ATTEMPTS=3
S3_CONNECT_TIMEOUT=2
S3_REQUEST_TIMEOUT=10
S3_MAX_READ_BYTES=10485760

MAILER_DSN=smtp://mailpit:1025
APP_KEY=replace-for-local-tests
PASSWORD_PEPPER=replace-for-local-tests
FINANCE_HMAC_KEY=replace-for-local-tests
