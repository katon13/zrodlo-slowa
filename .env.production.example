# Wzorzec produkcyjny. Sekrety dostarczaj z menedżera sekretów, nie z repozytorium.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.invalid
APP_TIMEZONE=UTC
APP_KEY=__FROM_SECRET_MANAGER__
PASSWORD_PEPPER=__FROM_SECRET_MANAGER__
FINANCE_HMAC_KEY=__FROM_SECRET_MANAGER__

# Nie przechodź do test/required przez samą edycję pliku. Wymagana jest bramka 3DORS.
DORS3_MODE=prepare
DORS3_FIDO2_ENABLED=false
DORS3_FIDO2_REQUIRED=false
DORS3_CRITICAL_STEP_UP=password
DORS3_PHYSICAL_APPROVAL=disabled
DORS3_ADMIN_IDLE_TIMEOUT_SECONDS=900
DORS3_ADMIN_SESSION_MAX_SECONDS=28800
WEBAUTHN_ENABLED=false
WEBAUTHN_RP_ID=example.invalid
WEBAUTHN_RP_NAME="Źródło Słowa — 3DORS"
WEBAUTHN_ORIGIN=https://example.invalid
WEBAUTHN_USER_VERIFICATION=required
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
WEBAUTHN_STEP_UP_TTL_SECONDS=300

DB_DRIVER=pgsql
DB_HOST=__MANAGED_POSTGRES_HOST__
DB_PORT=5432
DB_NAME=__DATABASE_NAME__
DB_USER=__DATABASE_USER__
DB_PASS=__FROM_SECRET_MANAGER__
DB_SSLMODE=require
DB_SCHEMA=public
DB_APPLICATION_NAME=zrodlo-slowa-web
DB_ALLOW_CREATE_DATABASE=false
DB_ALLOW_CREATE_SCHEMA=false

VALKEY_HOST=__MANAGED_VALKEY_HOST__
VALKEY_PORT=6379
VALKEY_PASSWORD=__FROM_SECRET_MANAGER__
VALKEY_DATABASE=0
VALKEY_TLS=true
VALKEY_PREFIX=zrodlo-slowa:production
VALKEY_CONNECT_TIMEOUT=0.5
VALKEY_READ_TIMEOUT=0.5
SESSION_DRIVER=valkey
SESSION_TTL_SECONDS=86400
CACHE_DRIVER=valkey
RATE_LIMIT_DRIVER=valkey
LOCK_DRIVER=valkey
QUEUE_SIGNAL_DRIVER=valkey
QUEUE_DRIVER=database

OBJECT_STORAGE_DRIVER=s3
S3_ENDPOINT=__S3_COMPATIBLE_ENDPOINT__
S3_REGION=__S3_REGION__
S3_BUCKET=__PRIVATE_BUCKET__
S3_ACCESS_KEY=__FROM_SECRET_MANAGER__
S3_SECRET_KEY=__FROM_SECRET_MANAGER__
S3_PATH_STYLE=false
S3_MAX_ATTEMPTS=3
S3_CONNECT_TIMEOUT=2
S3_REQUEST_TIMEOUT=10
S3_MAX_READ_BYTES=10485760

MAILER_DSN=__FROM_SECRET_MANAGER__
MAIL_FROM_ADDRESS=no-reply@example.invalid
MAIL_FROM_NAME=ŹRÓDŁO SŁOWA

SESSION_SECURE=true
HEALTHCHECK_DATABASE=true
HEALTHCHECK_VALKEY=true
HEALTHCHECK_OBJECT_STORAGE=true
