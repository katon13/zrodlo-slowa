APP_NAME="ŹRÓDŁO SŁOWA"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=generate-at-least-32-random-characters

DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=zrodlo_slowa
DB_USER=postgres
DB_PASS=
DB_CHARSET=utf8
DB_SCHEMA=public
DB_SSLMODE=prefer
DB_APPLICATION_NAME=zrodlo-slowa
DB_ALLOW_CREATE_DATABASE=false
DB_ALLOW_CREATE_SCHEMA=false

SESSION_NAME=zrodlo_slowa_session
SESSION_LIFETIME=0
SESSION_SECURE=false
SESSION_SAME_SITE=Lax
SESSION_DOMAIN=
SESSION_DRIVER=file
SESSION_SAVE_PATH=storage/sessions
SESSION_TTL_SECONDS=86400
PASSWORD_PEPPER=change-this-long-random-string
FINANCE_HMAC_KEY=generate-a-separate-strong-random-secret

# 3DORS: przed zakupem klucza pozostaw dokładnie tryb prepare i wyłączone FIDO2.
DORS3_MODE=prepare
DORS3_FIDO2_ENABLED=false
DORS3_FIDO2_REQUIRED=false
DORS3_CRITICAL_STEP_UP=password
DORS3_PHYSICAL_APPROVAL=disabled
DORS3_MOBILE_ENABLED=false
DORS3_MOBILE_MODE=disabled
DORS3_MOBILE_API_TOKEN_TTL_SECONDS=2592000
DORS3_ADMIN_APP_ENABLED=false
DORS3_AUTHOR_APP_ENABLED=false
DORS3_ARTICLE_SUBMIT_APPROVAL=false
DORS3_ARTICLE_PUBLISH_APPROVAL=false
DORS3_PAYOUT_APPROVAL=false
DORS3_ADMIN_CRITICAL_APPROVAL=false
DORS3_ADMIN_APP_LINK_BASE_URL=https://admin-3dors.przyklad-domeny.pl/3dors/approve
DORS3_AUTHOR_APP_LINK_BASE_URL=https://author-3dors.przyklad-domeny.pl/3dors/approve
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=CHANGE_ME_SHA256_CERT_FINGERPRINT
DORS3_ADMIN_IDLE_TIMEOUT_SECONDS=900
DORS3_ADMIN_SESSION_MAX_SECONDS=28800
WEBAUTHN_ENABLED=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Źródło Słowa — 3DORS"
WEBAUTHN_ORIGIN=http://localhost:8080
WEBAUTHN_USER_VERIFICATION=required
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
WEBAUTHN_STEP_UP_TTL_SECONDS=300

VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DATABASE=0
VALKEY_TLS=false
VALKEY_PREFIX=zrodlo-slowa:local
VALKEY_CONNECT_TIMEOUT=0.5
VALKEY_READ_TIMEOUT=0.5
CACHE_DRIVER=file
RATE_LIMIT_DRIVER=database
LOCK_DRIVER=none
QUEUE_SIGNAL_DRIVER=none

OBJECT_STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=public/uploads
LOCAL_STORAGE_PUBLIC_PREFIX=/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=false
S3_MAX_ATTEMPTS=3
S3_CONNECT_TIMEOUT=2
S3_REQUEST_TIMEOUT=10
S3_MAX_READ_BYTES=10485760

ADMIN_EMAIL=admin@zrodlo-slowa.local
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

MAIL_TRANSPORT=smtp
MAIL_FROM_ADDRESS=no-reply@zrodlo-slowa.local
MAIL_FROM_NAME="ŹRÓDŁO SŁOWA"
# Alternatywnie ustaw pełny DSN, np. smtp://user:pass@smtp.example.com:587
MAILER_DSN=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=tls


# PATCH 4 / Stripe + Przelewy24
PAYMENTS_ENABLED=true
PAYMENT_DEFAULT_PROVIDER=stripe

STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=pln
STRIPE_PAYMENT_METHODS=card,p24

STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:8080/wallet/topup/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:8080/wallet/topup/cancel
STRIPE_WEBHOOK_URL=http://localhost:8080/stripe/webhook


# PATCH 5 / OpenAI + fundament AI redakcyjnego
AI_ENABLED=false
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_TEMPERATURE=0.2


# Lokalna diagnostyka Clockwork; tylko development/localhost
CLOCKWORK_ENABLE=false
SLOWO_CLOCKWORK=false

GOOGLE_LOGIN_ENABLED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

APPLE_LOGIN_ENABLED=0
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=http://localhost:8080/auth/apple/callback
SENTINEL_EXPECTED_INSTANCES=app-1,app-2
SENTINEL_HEARTBEAT_STALE_SECONDS=45
SENTINEL_ARCHIVE_CHUNK_SIZE=1000
SENTINEL_LOG_STORAGE_WARNING_BYTES=1073741824
SENTINEL_LOG_STORAGE_CRITICAL_BYTES=5368709120
